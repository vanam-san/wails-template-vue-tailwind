package main

import (
	"embed"
	"log"

	"github.com/wailsapp/wails/v3/pkg/application"
)

// Wails serves the Vite bundle from the executable in production.
//
//go:embed all:frontend/dist
var assets embed.FS

func main() {
	// Register the same service the Wails binding generator exposes to Vue.
	app := application.New(application.Options{
		Name:        {{printf "%q" .ProjectName}},
		Description: {{printf "%q" .ProductDescription}},
		Services: []application.Service{
			application.NewService(&GreetService{}),
		},
		Assets: application.AssetOptions{
			Handler: application.AssetFileServerFS(assets),
		},
		Mac: application.MacOptions{
			ApplicationShouldTerminateAfterLastWindowClosed: true,
		},
	})

	// "/" loads the Vue entry page through the Wails asset server.
	app.Window.NewWithOptions(application.WebviewWindowOptions{
		Title:     {{printf "%q" .ProductName}},
		Width:     1120,
		Height:    760,
		MinWidth:  380,
		MinHeight: 580,
		URL:       "/",
	})

	if err := app.Run(); err != nil {
		log.Fatal(err)
	}
}
