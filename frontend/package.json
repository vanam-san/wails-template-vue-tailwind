    "build:dev": "vite build --mode development --minify false"
  },
  "dependencies": {
    "@vueuse/core": "15.0.0",
    "@wailsio/runtime": "3.1.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-vue-next": "1.0.0",
    "reka-ui": "2.11.0",
    "shadcn-vue": "2.9.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.0",
    "vue-tsc": "3.3.14"
  }
